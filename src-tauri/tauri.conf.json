{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinda Leave Ledger",
  "version": "0.1.0",
  "identifier": "com.cindainternational.hr.leaveledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "休假账本",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Business",
    "shortDescription": "员工个人假期管理工具",
    "longDescription": "用于记录、统计和查看员工个人请假及香港公众假期的桌面工具。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
